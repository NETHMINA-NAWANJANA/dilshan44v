rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && myUser().data.role == "admin"
        && myUser().data.status == "active";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // User/profile fields are created and changed only by protected server routes.
      allow create, update, delete: if false;
    }

    match /studentPhotos/{userId} {
      // Student can create/update only their own photo. Admin can read all.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() < 250000;

      allow delete: if isAdmin();
    }

    match /attendanceLocks/{studentId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      // Daily fee settings are read/written only through the
      // protected admin API routes (Firebase Admin SDK).
      allow read, write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid
      );

      // Attendance writes happen only through the Firebase Admin SDK API routes.
      allow create, update, delete: if false;
    }

    match /examResults/{resultId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid
      );

      // Exam results are written only through the protected admin API routes.
      allow create, update, delete: if false;
    }
  }
}
